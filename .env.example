ENVIRONMENT=local
DATABASE_URL=sqlite:///./deploylens.sqlite3
DATABASE_SSLMODE=disable
# Cloud: use PostgreSQL + require TLS. Never use SQLite on ephemeral hosting.
DATABASE_SCHEMA=public
ADMIN_TOKEN=replace-with-a-random-token-at-least-32-characters
GITHUB_REPOSITORY=Gauravwakle96/deploylens
MONITOR_URL=https://module3-feedback-board.onrender.com/health
MONITOR_NAME=Feedback Board
CHECK_INTERVAL_SECONDS=60
GITHUB_INTERVAL_SECONDS=300
COLLECTOR_ENABLED=true
APP_VERSION=local
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
